[Unit]
Description=Bring the update waiting for the next start to the newest version
Documentation=https://github.com/Raye-Linux/update
# Does nothing at start-up. As the PC stops, its ExecStop runs before the
# network goes (stopped in the reverse order: after the network here means
# before it on the way down): the update armed for the next start is
# replaced by the newest version if one came out since the last check.
# Without network, or after a recent check, it does nothing.
After=network-online.target NetworkManager.service systemd-networkd.service systemd-resolved.service
ConditionPathExists=/usr/libexec/raye-update

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
# --stopping: nothing unless the PC really stops (an upgrade of this
# package restarting the unit must not touch apt while dpkg runs)
ExecStop=/usr/libexec/raye-update catch-up --stopping
# the lists in a minute, the files in four (raye_update.py), then the PC goes on
TimeoutStopSec=6min

[Install]
WantedBy=multi-user.target
