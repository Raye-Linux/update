#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_install:
	install -Dm755 src/raye_update.py debian/raye-update/usr/libexec/raye-update

override_dh_auto_test:
	python3 -m pytest -q tests

override_dh_installsystemd:
	dh_installsystemd --name=raye-update raye-update.timer
	dh_installsystemd --name=raye-update --no-enable --no-start raye-update.service
	dh_installsystemd --name=raye-update-restart raye-update-restart.timer
	dh_installsystemd --name=raye-update-restart --no-enable --no-start raye-update-restart.service
	dh_installsystemd --name=raye-update-shutdown-screen --no-start raye-update-shutdown-screen.service
	# started at install so its ExecStop runs at the next shutdown; never
	# stopped or restarted by an upgrade (catch-up --stopping does nothing
	# then anyway)
	dh_installsystemd --name=raye-update-catch-up --no-stop-on-upgrade --no-restart-after-upgrade raye-update-catch-up.service
	# runs only at start-up in system-update.target, never started by hand
	# and never stopped by an upgrade of this package: that would kill the
	# install it is part of
	dh_installsystemd --name=raye-update-install --no-start --no-stop-on-upgrade raye-update-install.service
	# at start-up only, before the sign-in screen; never started by the
	# upgrade itself (it would restart the PC in the middle of it)
	dh_installsystemd --name=raye-update-kernel-switch --no-start --no-stop-on-upgrade raye-update-kernel-switch.service

override_dh_installsystemduser:
	dh_installsystemduser --name=raye-update-notify
	dh_installsystemduser --name=raye-update-progress raye-update-progress.path
